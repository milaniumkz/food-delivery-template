# Local only. tools/bootstrap.mjs creates random credentials without overwriting .env.
NODE_ENV=development
PAYMENT_PROVIDER=mock
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://food_local:CHANGE_ME@127.0.0.1:5432/food_local?connect_timeout=3&socket_timeout=3
PORT=3001
# BRAND_CONFIG=../../brands/demo/brand.json
# 32 random bytes encoded as 64 hex characters; generated by bootstrap, never commit a real value.
AUTH_KEY=GENERATE_LOCALLY
REDIS_URL=redis://127.0.0.1:6379
# ADMIN_ORIGIN=http://127.0.0.1:3000
# ADMIN_API_URL=http://127.0.0.1:3001
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081

# API_HOST=127.0.0.1
# MEDIA_DIRECTORY=../../.local/media
