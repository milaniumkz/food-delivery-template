{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public Brand v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "applicationId",
    "apiBaseUrl",
    "currency",
    "locales",
    "defaultLocale",
    "timeZone",
    "primaryColor",
    "onPrimary",
    "surfaceColor",
    "textColor",
    "logoAsset",
    "supportEmail"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "\\S"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){2,}$"
    },
    "apiBaseUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 300
    },
    "currency": {
      "const": "KZT"
    },
    "locales": {
      "type": "array",
      "items": {
        "enum": ["ru", "kk"]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "defaultLocale": {
      "enum": ["ru", "kk"]
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "logoAsset": {
      "type": "string",
      "pattern": "^assets/[a-zA-Z0-9_/-]+\\.svg$"
    },
    "supportEmail": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "primaryColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "onPrimary": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "surfaceColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "textColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
